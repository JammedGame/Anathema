{
  "name": "anathema",
  "version": "0.0.1",
  "description": "Game where you curse like there is no tomorrow.",
  "main": "build/public/anathema.js",
  "scripts": {
    "start": "concurrently -k \"npm run build\" \"npm run serve\"",
    "start-win": "SET NODE_OPTIONS=--openssl-legacy-provider && concurrently -k \"npm run build\" \"npm run serve\"",
