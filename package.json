  "bugs": {
    "url": "https://github.com/ShadySolutions/Anathema/issues"
  },
  "homepage": "https://github.com/ShadySolutions/Anathema#readme",
  "devDependencies": {
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "webpack": "^5.102.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@types/howler": "^2.2.12",
    "@types/three": "^0.179.0",
    "concurrently": "^9.2.1",
    "engineer-js": "0.0.70",
    "howler": "^2.2.4",
