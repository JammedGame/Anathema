  },
  "homepage": "https://github.com/ShadySolutions/Anathema#readme",
  "devDependencies": {
    "typescript": "2.8.1",
    "webpack": "3.5.3",
    "webpack-dev-server": "2.7.1"
  },
  "dependencies": {
    "@types/howler": "2.0.5",
    "@types/three": "0.93.31",
    "concurrently": "^5.0.2",
    "engineer-js": "0.0.70",
    "howler": "2.1.1",
